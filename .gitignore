node_modules/
.DS_Store
__pycache__/
scripts/__pycache__/
components/**/__pycache__/
cache/

# Build output — generated by `npm run build` (see build/build.js).
# GitHub Actions builds and deploys this automatically; never commit it.
dist/

# Vendored third-party assets — regenerated by `npm install` (postinstall
# runs scripts/vendor-assets.js). No need to commit a copy.
vendor/

# Leftover empty folders from the components/ refactor — safe to delete.
_to_delete/

# Personal scratch notes, not part of the site.
_rundown.txt

# Local dining-rankings ingest inputs (optional; used by
# scripts/dining-rankings-ingest.py). The committed artifacts are
# components/dining/rankings/lists/*.json and rankings.json.
components/dining/rankings/sources/
